# ---------- SerpApi (core data layer) ----------
# https://serpapi.com/manage-api-key  — never exposed to the frontend.
SERPAPI_KEY=

# ---------- Groq (open-source LLMs: Llama / GPT-OSS ...) ----------
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ---------- Behaviour ----------
# true  => requests without an explicit mode use the deterministic demo snapshot
DEMO_MODE=false
# hard cap on SerpApi calls a single journey may spend (protects your quota)
SERPAPI_MAX_CALLS_PER_JOURNEY=70
# comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Google locale used for SerpApi queries
SERPAPI_GL=in
SERPAPI_HL=en
SERPAPI_CURRENCY=INR
